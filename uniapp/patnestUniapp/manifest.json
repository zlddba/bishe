{
    "name" : "宠栖PatNest",
    "appid" : "__UNI__24E4D49",
    "description" : "宠栖 PatNest 微信小程序 · 宠物寄养服务预约（主人端）",
    "versionName" : "2.0.4",
    "versionCode" : "120",
    "transformPx" : false,
    /* 本项目小程序端只覆盖微信小程序（mp-weixin）内容，
       其余平台（H5 / App / 各家小程序）不在本仓库实现范围内。 */
    "mp-weixin" : {
        "appid" : "wx1366ab99a6b27171",
        "setting" : {
            "urlCheck" : false,
            "es6" : true,
            "minified" : true,
            "postcss" : true
        },
        "usingComponents" : true,
        /* 组件按需注入（微信小程序「按需注入」能力）：
           启动时只注入当前页面真正用到的组件代码，而不是把 components/ 下
           的全部组件打进首屏。配合 easycom（pages.json）使用：
           编译期仍按页面自动引入组件，运行期只加载用到的那部分。
           ⚠️ 开启后不要用 <component :is="名字"> 这类动态组件 —— 编译器
              分析不到引用，组件不会被打进页面，运行时报「组件不存在」。
              本项目全部是静态标签，无此风险。 */
        "lazyCodeLoading" : "requiredComponents",
        /* 定位与导航（见 docs/10-定位与导航服务配置指南.md §4.1）
           requiredPrivateInfos 微信只认这 8 个隐私接口：
             getFuzzyLocation / getLocation / onLocationChange /
             startLocationUpdate / startLocationUpdateBackground /
             chooseLocation / choosePoi / chooseAddress
           ⚠️ openLocation（打开地图）不在其中，写进去会导致开发者工具报
              「requiredPrivateInfos 字段有误」并模拟器启动失败。
           ⚠️ getFuzzyLocation 与 getLocation 不能同时声明。
           本项目只用 getLocation（uni.getLocation），chooseLocation 没用到。
           还需在微信公众平台 → 开发管理 → 接口设置 申请开通对应接口权限。 */
        "permission" : {
            "scope.userLocation" : {
                "desc" : "用于按距离排序机构并提供到店导航"
            }
        },
        "requiredPrivateInfos" : [ "getLocation", "chooseLocation" ]
    },
    "vueVersion" : "3"
}
