<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 后端是局域网 http 地址， cleartext 必须放开，否则 9 以上会直接拦掉请求 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 高德地图 SDK 用它判断网络状况、决定用在线瓦片还是离线缓存 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
        「我的位置」用的系统定位（ui/app/DeviceLocation.kt）。
        两个都声明：Android 12 起用户可以选择「大概位置」，只给 COARSE 时也要能用。
        运行时由地图页按需申请，不在启动时就弹窗。
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!--
        商家直播：软件内直接开播要采集摄像头与麦克风（RootEncoder → RTMP）。
        运行时权限在 LiveBroadcaster 里按需申请，不在启动时弹窗。
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!--
        「拍照上传」用的是系统相机（ACTION_IMAGE_CAPTURE），不申请 CAMERA 权限，
        所以声明为非必需：没有摄像头的设备照样能装，届时选图面板里的「拍照」会置灰。
    -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!--
        导航跳转的目标 App。Android 11+ 起，应用默认看不到别的应用，
        queries 里列出来才能在设置/分享等场景正确判断"装没装"。
        startActivity 本身不受可见性限制，这里声明是为了让 Intent 解析结果与系统一致。
    -->
    <queries>
        <package android:name="com.autonavi.minimap" />
        <package android:name="com.baidu.BaiduMap" />
        <package android:name="com.tencent.map" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <!--
            「拍照」用的系统相机。Android 11 起不声明就拿不到解析结果，
            应用会以为没装相机而退回相册。
        -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name_zh"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.PatNest">

        <!--
            高德地图 SDK 只从 meta-data 读 Key（Web 服务 Key 在这里无效，会报 INVALID_USER_SCODE）。
            值由构建期从 .env 的 PATNEST_AMAP_ANDROID_KEY 注入；为空时 App 自动改用后端瓦片底图。
        -->
        <meta-data
            android:name="com.amap.api.v2.apikey"
            android:value="${amapKey}" />

        <activity
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            拍照时把「写原图」的文件地址通过 content:// 授权给系统相机，
            这样不用申请相机/存储权限，应用也只暴露自己缓存目录里的那一个文件。
            authority 必须和 MobilePicker.kt 里的 "${packageName}.fileprovider" 一致。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
