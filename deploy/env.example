# 在发布机执行脚本前 source 本文件（复制为 deploy/.env 并填写）

# 后端目录与 Nginx
APP_DIR=/opt/patnest/api
WEB_DIR=/opt/patnest/web
UPSTREAM_FILE=/etc/nginx/patnest/upstream.conf

# 蓝绿端口，需与 slot.blue / slot.green 保持一致
BLUE_PORT=9200
GREEN_PORT=9201

# 数据库（写发布记录用，与后端 .env 中的连接信息一致）
DATABASE_URL=postgres://用户名:密码@zdz.linkzdsada.dpdns.org:5432/patnest_db?sslmode=disable

# 可选项
KEEP_RELEASES=5
DRAIN_SECONDS=8
SKIP_MIGRATE=0
