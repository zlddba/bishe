# 本地已构建好管理页面，服务器只做镜像打包
FROM nginx:latest

# 对象存储地址在构建时写进 nginx 配置（/files/ 反代目标）。
# compose 会从 .env 取 MINIO_* 传进来，所以它和后端用的是同一份配置。
ARG MINIO_SCHEME=http
ARG MINIO_ENDPOINT=zdz1.linkzdsada.dpdns.org:9000
ARG MINIO_BUCKET=patnest-uploads

RUN rm -f /etc/nginx/conf.d/default.conf

# default.conf 只留一个 server 声明（9200），具体规则在 locations.conf 里
COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY docker/nginx/locations.conf /etc/nginx/patnest/locations.conf
# 反代协议默认值（后端跑 http）。发布时会按 .env 的 SERVER_SCHEME 重写并挂载覆盖。
COPY docker/nginx/api_proxy.conf /etc/nginx/patnest/api_proxy.conf

RUN sed -i \
        -e "s|@@MINIO_SCHEME@@|${MINIO_SCHEME}|g" \
        -e "s|@@MINIO_ENDPOINT@@|${MINIO_ENDPOINT}|g" \
        -e "s|@@MINIO_BUCKET@@|${MINIO_BUCKET}|g" \
        /etc/nginx/patnest/locations.conf

# 注意：这里没有证书热加载守护脚本了。
# HTTPS 改由后端自己在 9200 上终结（证书从后台上传到 TLS 目录，握手时现读），
# nginx 不再终结 TLS，也就不需要 reload nginx。

COPY web/dist/ /usr/share/nginx/html/

EXPOSE 9200
