# ===== compose =====
COMPOSE_PROJECT_NAME=patnest
APP_VERSION=1.0.0
PUBLIC_PORT=9200
GIT_COMMIT=f79173c
BUILD_TIME=2026-10-30T02:20:00Z
# 以下两项由 compose 按槽位写死（api-blue / api-green 容器内都是 9201），
# 写进 .env 也不会生效，列在这里只作对照，不用补：
# APP_PORT=9201
# APP_SLOT=blue

# ===== 后端对外协议 =====
# 后端启动时的初始协议：http（默认）或 https。
# 证书与开关本身在后台「系统更新 → HTTPS 证书」里管：
#   - 在页面上传证书 → 落盘到 nginx/tls/（fullchain.pem / privkey.pem）；
#   - 在页面上打开「后端同时接受 HTTPS」→ 后端 9200 端口立刻同时收 http 与 https，
#     不用重启、不用改这里，nginx 的明文反代也不受影响。
# 这里只兜底"启动那一刻"的初始状态：写 https 表示一启动就要求证书可用，
# 证书不在则后端启动失败（不会悄悄退回明文）。
SERVER_SCHEME=http

# Swagger 接口文档：启动后访问 http://<host>:9200/swagger/index.html
# 默认开启；不想对外暴露接口清单时设为 false。
SWAGGER_ENABLED=true

# 后端 HTTPS 证书目录（容器内路径，由 compose 挂载 ./nginx/tls）。
# 默认值就是这个，一般不用改；证书请从后台「系统更新 → HTTPS 证书」上传，不要手工放文件。
TLS_DIR=/var/lib/patnest/tls

# ===== Let's Encrypt 自动证书（镜像内置 acme.sh）=====
# 后台「HTTPS 证书 → Let's Encrypt 自动证书」可以直接申请 / 续期，不需要装 certbot。
# 验证方式是 DNS-01（在 Cloudflare 加 _acme-challenge TXT 记录），
# 所以不占用 80/443 任何端口，站点只开 9200 也能签证书。
#
# 下面几项只是「首次打开页面时的默认值」：在页面上改完会写到 data/acme/settings.json，
# 之后以页面上的为准（改 .env 要重建容器，日常操作请走页面）。
#
# Cloudflare API Token 建议直接在后台页面填（只落盘到 data/acme，不会写进 .env）。
# 需要的最小权限：Zone → Zone → Read、Zone → DNS → Edit。
ACME_DOMAIN=
ACME_EMAIL=
# 自动续期：为 true 时后端 worker 每 12 小时检查一次，剩余天数小于阈值就续
ACME_AUTO_RENEW=true
ACME_RENEW_DAYS=30

# ===== 应用 =====
JWT_SECRET=CHANGE_ME_JWT_SECRET

# 访问令牌有效期（分钟），默认 30；桌面端和后台管理端都已支持用 refresh_token 静默续期
JWT_ACCESS_TTL_MINUTES=30

# 跨域白名单：逗号分隔的可信来源，不填时只放行本机 vite dev（127.0.0.1:5173 / localhost:5173）。
# 后台 dist 与 /api 同源、桌面端和小程序不带 Origin，正常部署不需要配置。
CORS_ALLOW_ORIGINS=

# 公开接口限流（每小时每 IP）：注册 10 次、刷新 60 次。
# 现场多人共用一个出口 IP 时，这两个值按人数放大，别让限流把答辩演示挡住。
REGISTER_RATE_LIMIT=10
REFRESH_RATE_LIMIT=60
# 图片上传限流：按登录用户计数（每小时每人），防止账号被盗后批量投放内容
UPLOAD_RATE_LIMIT=60

# 审计日志保留天数，后台 worker 每天清理一次早于该期限的记录
AUDIT_RETENTION_DAYS=180

# ===== 远程数据库 =====
DB_HOST=zdz.linkzdsada.dpdns.org
DB_PORT=5432
DB_NAME=patnest_db
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# ===== MinIO =====
MINIO_ENDPOINT=zdz.linkzdsada.dpdns.org:9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET=patnest-uploads
MINIO_USE_SSL=false
# nginx 的 /files/ 反代到对象存储时用的协议（构建 nginx 镜像时由 compose 传给 Dockerfile.web）。
# 与 MINIO_USE_SSL 保持一致：false -> http，true -> https；改这里后要重建 nginx 镜像。
MINIO_SCHEME=http

# 图片对外前缀，必须包含 /files（Nginx 的 location /files/ 反代到对象存储）。
# 数据库只存相对路径 /uploads/...，接口返回时在这里拼接成完整地址。
# 留空则回退对象存储直链（兼容老部署，但会把存储地址暴露给前端）。
PUBLIC_FILE_BASE=http://zdz1.linkzdsada.dpdns.org:9200/files

# ===== Redis =====
REDIS_ADDR=redis:6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0

# ===== 高德地图 =====
# Web 服务 API Key（机构地址地理编码 / 距离计算，仅后端使用；console.amap.com 申请，服务平台选 Web服务）
AMAP_KEY=CHANGE_ME_AMAP_KEY
AMAP_BASE_URL=https://restapi.amap.com
# JS API Key（桌面端“在地图中选点”页面用；同一应用下再建一张，服务平台选 JS API）
# 域名白名单要放行后端对外访问地址（如 http://192.168.3.100:9200），留空表示不限制
AMAP_JS_KEY=CHANGE_ME_AMAP_JS_KEY
AMAP_JS_SECURITY_CODE=CHANGE_ME_AMAP_JS_SECURITY_CODE

# ===== 热更新 =====
# 容器内更新目录，由 compose 挂载 ./data/updates
UPDATE_DIR=/var/lib/patnest/updates
# 管理页面“上传更新包”写入的临时目录
UPDATE_TMP_DIR=/var/lib/patnest/updates/tmp
# 手工投放更新包的目录（把 zip 放到这里，在后台点「检查更新」即可识别）
UPDATE_MANUAL_DIR=/var/lib/patnest/updates/manual
# 管理页面展示的宿主机目录提示
UPDATE_TMP_HINT=data/updates/tmp
UPDATE_MANUAL_HINT=data/updates/manual
UPDATE_MAX_MB=512
UPDATE_AGENT_STALE_SECONDS=30

# 容器引擎选择：docker（默认）/ podman / auto。
# auto = 优先 docker，检测不到可用的 docker 再改用 podman，两者都不可用则安装脚本报错退出。
# 运行时也可指定：bash scripts/install.sh --engine podman
#                 .\scripts\install.ps1 -Engine podman
# 或在这里固定（auto 等价于不填，可改成 docker / podman）：
PATNEST_ENGINE=auto

# 更新代理运行方式：
#   container  默认；代理跑在容器里（compose 的 agent profile），挂 docker.sock 执行发布
#   host       宿主机脚本（仅手动调试时用，install 不再默认安装）
#   none       不启动代理，系统更新页会显示离线
# 安全提示：container 会把 docker.sock 挂进代理容器，等于授予它宿主机容器引擎的控制权，
# 因为它需要执行 docker compose build / up 来发布新版本。不希望这样请设 none。
AGENT_MODE=container
# 部署包在本机上的路径，install 脚本会自动写入并覆盖这里
# （Linux 如 /opt/patnest，Windows 如 D:/dockers/patnest-docker，正斜杠）。
# 容器内固定挂到 /pkg；代理启动后会 docker inspect 反查 daemon 侧真实路径，
# 所以不再要求「宿主机与容器同路径挂载」。
PACKAGE_HOST_PATH=/opt/patnest
# 逃生口：docker inspect 查不到挂载源时（Podman 兼容 API 下较常见），
# 手工指定宿主机看到的部署包绝对路径，可绕过 inspect。
# 可选项，不用补；只有 inspect 真的失败时才打开下面这一行。
# PACKAGE_HOST_ROOT=/opt/patnest
# 引擎 socket（只影响宿主机侧挂载源；容器内 docker CLI 固定连 /var/run/docker.sock）。
# Docker 默认 /var/run/docker.sock；rootless Docker 常见 $XDG_RUNTIME_DIR/docker.sock。
# Podman 需先启用兼容 socket：
#   rootful  systemctl enable --now podman.socket        -> /run/podman/podman.sock
#   rootless systemctl --user enable --now podman.socket -> $XDG_RUNTIME_DIR/podman/podman.sock
# 用 Podman 跑容器代理时把下面这行改成对应路径。
DOCKER_SOCKET=/var/run/docker.sock
# 代理轮询 queue 的间隔（秒），心跳同频刷新
POLL_SECONDS=3
