# ===== compose =====
COMPOSE_PROJECT_NAME=patnest
APP_VERSION=1.0.0
PUBLIC_PORT=9200
GIT_COMMIT=f79173c
BUILD_TIME=2026-10-30T02:20:00Z

# ===== 应用 =====
JWT_SECRET=请替换为至少32位的随机字符串

# 访问令牌有效期（分钟），默认 30；桌面端和后台管理端都已支持用 refresh_token 静默续期
JWT_ACCESS_TTL_MINUTES=30

# 跨域白名单：逗号分隔的可信来源，不填时只放行本机 vite dev（127.0.0.1:5173 / localhost:5173）。
# 后台 dist 与 /api 同源、桌面端和小程序不带 Origin，正常部署不需要配置。
CORS_ALLOW_ORIGINS=

# 公开接口限流（每小时每 IP）：注册 10 次、刷新 60 次。
# 现场多人共用一个出口 IP 时，这两个值按人数放大，别让限流把答辩演示挡住。
REGISTER_RATE_LIMIT=10
REFRESH_RATE_LIMIT=60
# 图片上传限流：按登录用户计数（每小时每人），防止账号被盗后批量投放内容
UPLOAD_RATE_LIMIT=60

# 审计日志保留天数，后台 worker 每天清理一次早于该期限的记录
AUDIT_RETENTION_DAYS=180

# ===== 远程数据库 =====
DB_HOST=zdz.linkzdsada.dpdns.org
DB_PORT=5432
DB_NAME=patnest_db
DB_USER=postgres
DB_PASSWORD=请填写数据库密码

# ===== MinIO =====
MINIO_ENDPOINT=zdz.linkzdsada.dpdns.org:9000
MINIO_ACCESS_KEY=请填写
MINIO_SECRET_KEY=请填写
MINIO_BUCKET=patnest-uploads
MINIO_USE_SSL=false

# 图片对外前缀，必须包含 /files（Nginx 的 location /files/ 反代到对象存储）。
# 数据库只存相对路径 /uploads/...，接口返回时在这里拼接成完整地址。
# 留空则回退对象存储直链（兼容老部署，但会把存储地址暴露给前端）。
PUBLIC_FILE_BASE=http://zdz1.linkzdsada.dpdns.org:9200/files

# ===== Redis =====
REDIS_ADDR=redis:6379
REDIS_PASSWORD=请替换为Redis密码
REDIS_DB=0

# ===== 高德地图 =====
# Web 服务 API Key（机构地址地理编码 / 距离计算，仅后端使用；console.amap.com 申请，服务平台选 Web服务）
AMAP_KEY=请填写高德Web服务Key
AMAP_BASE_URL=https://restapi.amap.com
# JS API Key（桌面端“在地图中选点”页面用；同一应用下再建一张，服务平台选 JS API）
# 域名白名单要放行后端对外访问地址（如 http://192.168.3.100:9200），留空表示不限制
AMAP_JS_KEY=请填写高德JSAPIKey
AMAP_JS_SECURITY_CODE=请填写JSAPI安全密钥

# ===== 热更新 =====
# 容器内更新目录，由 compose 挂载 ./data/updates
UPDATE_DIR=/var/lib/patnest/updates
# 管理页面“上传更新包”写入的临时目录
UPDATE_TMP_DIR=/var/lib/patnest/updates/tmp
# 管理页面展示的宿主机目录提示
UPDATE_TMP_HINT=data/updates/tmp
UPDATE_MANUAL_HINT=data/updates/manual
UPDATE_MAX_MB=512
UPDATE_AGENT_STALE_SECONDS=30

# 更新代理运行方式：
#   container  默认；代理跑在容器里（compose 的 agent profile），挂 docker.sock 执行发布
#   host       宿主机脚本（仅手动调试时用，install 不再默认安装）
#   none       不启动代理，系统更新页会显示离线
# 安全提示：container 会把 docker.sock 挂进代理容器，等于授予它宿主机容器引擎的控制权，
# 因为它需要执行 docker compose build / up 来发布新版本。不希望这样请设 none。
AGENT_MODE=container
# 部署包在本机上的路径，install 脚本会自动写入并覆盖这里
# （Linux 如 /opt/patnest，Windows 如 D:/dockers/patnest-docker，正斜杠）。
# 容器内固定挂到 /pkg；代理启动后会 docker inspect 反查 daemon 侧真实路径，
# 所以不再要求「宿主机与容器同路径挂载」。
PACKAGE_HOST_PATH=/opt/patnest
# 逃生口：docker inspect 查不到挂载源时（极少见），手工指定 daemon 看到的路径。
# PACKAGE_HOST_ROOT=/opt/patnest
# Docker Engine socket（rootless Docker 常见 $XDG_RUNTIME_DIR/docker.sock）
DOCKER_SOCKET=/var/run/docker.sock
# 代理轮询 queue 的间隔（秒），心跳同频刷新
POLL_SECONDS=3
