APP_PORT=9200
# 蓝绿发布槽位：blue / green（本地开发保持 blue 即可）
APP_SLOT=blue

# 后端启动时的初始协议：http 或 https。
# 证书与开关都在后台管理页面里管（「系统更新 → HTTPS 证书」），
# 这一项只决定**启动那一刻**的初始状态：
#   http  —— 初始不接 HTTPS（默认），页面上一开就生效，不用重启；
#   https —— 一启动就要求能接 HTTPS，证书不可用则启动直接失败。
# 页面上的开关优先级更高：页面上关掉后，这一项就不再强制。
SERVER_SCHEME=http

# 验证码登录演示模式：开启后 /auth/send-code 会把验证码返回给 App 本地通知展示。
# 仅供毕业设计演示；生产环境必须设为 false，并接入短信/邮件通道。
AUTH_CODE_DEMO=true

# Swagger 接口文档：启动后访问 http://<host>:9200/swagger/index.html
# 默认开启；不想对外暴露接口清单时设为 false。
# 也可以用管理员接口运行期切换：
#   GET/PUT /api/v1/admin/settings/swagger  {"enabled": true|false}
# 数据库里有 swagger_enabled 记录时以数据库为准，否则用本项。
SWAGGER_ENABLED=true

# PostgreSQL
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# MinIO
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=patnest-uploads
MINIO_USE_SSL=false

# JWT
JWT_SECRET=

# 访问令牌有效期（分钟），默认 30。
# 桌面端（KMP ApiClient）和后台管理端（axios 拦截器）都会在撞上 401 时用 refresh_token
# 静默换一张新令牌并重放请求，所以这里可以设得比较短；
# 接入新的客户端时如果没做静默续期，请把这一项调大，否则用户会中途掉线。
JWT_ACCESS_TTL_MINUTES=30

# 跨域白名单：逗号分隔的可信来源。
# 不填时只放行本机 vite dev（127.0.0.1:5173 / localhost:5173）；
# 后台 dist 与 /api 同源部署、桌面端与小程序不带 Origin，都不需要配这一项。
# 填 * 表示放开所有来源，等于放弃跨域读取限制，不建议。
CORS_ALLOW_ORIGINS=

# 公开接口限流阈值（每小时每 IP），不填用默认值；演示期反复注册测试账号可适当调大
REGISTER_RATE_LIMIT=10
# 刷新限流：访问令牌 30 分钟一张，正常客户端每小时约刷 2 次，60 够多人共用一个出口 IP
REFRESH_RATE_LIMIT=60
# 图片上传限流：按登录用户计数（每小时每人），防止账号被盗后批量投放内容
UPLOAD_RATE_LIMIT=60

# 审计日志保留天数：超过这个天数的 audit_logs 由后台 worker 每天分批清理，默认 180 天
AUDIT_RETENTION_DAYS=180

# 高德地图 Web 服务 API（机构地址地理编码 / 距离计算，仅后端使用）
# 申请入口：https://console.amap.com → 创建应用 → 添加 Key → 服务平台选“Web服务”
AMAP_KEY=
AMAP_BASE_URL=https://restapi.amap.com
# 高德 JS API Key（桌面端“地图选点”页面用；服务平台选 JS API，与上面的 Web服务 Key 不是同一张）
# 留空时桌面端会提示不可用，按地址解析坐标仍然可用
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=
